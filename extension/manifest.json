{
  "manifest_version": 3,
  "name": "Download Folder Recall",
  "version": "0.2.0",
  "description": "Learns download folders by URL and sends mapped release downloads to remembered folders.",
  "homepage_url": "https://github.com/iStarTAC/download-folder-recall",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "smart-download-folder-memory@example.local",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "142.0"
    }
  },
  "permissions": ["downloads", "storage", "menus", "nativeMessaging", "activeTab", "tabs"],
  "host_permissions": ["https://github.com/*", "https://*.nexusmods.com/*"],
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Download Folder Recall",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://*.nexusmods.com/*"],
      "js": ["src/content/download-link.js", "src/content/site-intent.js"],
      "run_at": "document_start"
    }
  ]
}
